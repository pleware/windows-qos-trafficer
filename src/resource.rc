#include <winresrc.h>
#include "resource.h"

// Declare DPI awareness
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

// Icon
1 ICON "bt-app.ico"

// --------------------------------------------------------------------
// Menu
// --------------------------------------------------------------------
IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Locate process...\t(Alt+L)",   ID_FILE_LOCATE_PROC
        MENUITEM "&Specify process...\t(Alt+P)",  ID_FILE_SPECIFY_PROC
        MENUITEM "&Remove sticky entry\t(Alt+R)", ID_FILE_REMOVE_CUSTOM
        MENUITEM SEPARATOR
        MENUITEM "E&xit\t(Alt+F4)",               ID_FILE_EXIT
    END

    POPUP "&View"
    BEGIN
        MENUITEM "&Refresh Processes\t(F5)", ID_VIEW_REFRESH
        MENUITEM "E&xpand All\t(Alt++)",     ID_VIEW_EXPAND_ALL
        MENUITEM "C&ollapse All\t(Alt+-)",   ID_VIEW_COLLAPSE_ALL
        MENUITEM SEPARATOR
        POPUP "Update &Frequency"
        BEGIN
            MENUITEM "Often (1 s)",     ID_FREQ_OFTEN
            MENUITEM "Normal (2 s)",    ID_FREQ_NORMAL
            MENUITEM "Slower (15 s)",   ID_FREQ_SLOWER
            MENUITEM "Scarcely (45 s)", ID_FREQ_SCARCELY
            MENUITEM "Rarely (2 min)",  ID_FREQ_RARELY
            MENUITEM SEPARATOR
            MENUITEM "Disabled",        ID_FREQ_DISABLED
        END
        POPUP "&Processes"
        BEGIN
            MENUITEM "Show &All\t(Alt+A)",          ID_PROC_SHOW_ALL
            MENUITEM "Show only s&ticky\t(Alt+S)",  ID_PROC_SHOW_CUSTOM
            MENUITEM "Show only &running\t(Alt+C)", ID_PROC_SHOW_RUNNING
        END
        MENUITEM SEPARATOR
        MENUITEM "&Options\t(Ctrl+O)",     ID_VIEW_OPTIONS
        MENUITEM "&Statistics\t(Ctrl+S)",  ID_VIEW_STATS
    END

    POPUP "&Help"
    BEGIN
        MENUITEM "&About", ID_HELP_ABOUT
    END
END

// --------------------------------------------------------------------
// Options Dialog
// --------------------------------------------------------------------
IDD_OPTIONS_DIALOG DIALOGEX 0, 0, 420, 450
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Options"
FONT 9, "Segoe UI"
BEGIN
    // Tab control (tab labels set at runtime via localization)
    CONTROL "", IDC_OPT_TABS, "SysTabControl32", TCS_TABS | WS_TABSTOP, 8, 6, 404, 22

    // ============================ Tab 0: Bandwidth ============================
    GROUPBOX "Global Bandwidth Limits", IDC_OPT_GRP_GLOBAL_LIMITS, 16, 40, 388, 84
    LTEXT "Download:", IDC_OPT_LBL_DOWNLOAD, 24, 58, 50, 10
    EDITTEXT IDC_OPT_DL_GLOBAL, 90, 56, 70, 12, ES_NUMBER
    LTEXT "KB/s (0 = unlimited)", IDC_OPT_LBL_DL_UNLIMITED, 170, 58, 90, 10

    LTEXT "Upload:", IDC_OPT_LBL_UPLOAD, 24, 76, 50, 10
    EDITTEXT IDC_OPT_UL_GLOBAL, 90, 74, 70, 12, ES_NUMBER
    LTEXT "KB/s (0 = unlimited)", IDC_OPT_LBL_UL_UNLIMITED, 170, 76, 90, 10

    LTEXT "Data cap:", IDC_OPT_LBL_DATA_CAP, 24, 96, 50, 10
    EDITTEXT IDC_OPT_DATA_CAP, 90, 94, 70, 12, ES_NUMBER
    LTEXT "MB (0 = unlimited)", IDC_OPT_LBL_DATA_CAP_UNLIM, 170, 96, 90, 10

    GROUPBOX "Buffer Settings", IDC_OPT_GRP_BUFFER_SETTINGS, 16, 132, 388, 84
    LTEXT "Download buffer:", IDC_OPT_LBL_DL_BUFFER, 24, 150, 80, 10
    EDITTEXT IDC_OPT_DL_BUFFER, 110, 148, 70, 12, ES_NUMBER
    LTEXT "bytes", IDC_OPT_LBL_BYTES, 190, 150, 30, 10

    LTEXT "Upload buffer:", IDC_OPT_LBL_UL_BUFFER, 24, 168, 80, 10
    EDITTEXT IDC_OPT_UL_BUFFER, 110, 166, 70, 12, ES_NUMBER
    LTEXT "bytes", IDC_OPT_LBL_BYTES2, 190, 168, 30, 10

    LTEXT "Burst size:", IDC_OPT_LBL_BURST_SIZE, 24, 188, 80, 10
    EDITTEXT IDC_OPT_BURST_SIZE, 110, 186, 70, 12, ES_NUMBER
    LTEXT "bytes (0 = auto)", IDC_OPT_LBL_BURST_AUTO, 190, 188, 60, 10

    // ============================ Tab 1: Network ==============================
    GROUPBOX "Network Interfaces", IDC_OPT_GRP_NIC_INTERFACES, 16, 40, 388, 130
    LTEXT "Selected NICs:", IDC_OPT_LBL_NIC_SELECTED, 24, 58, 100, 10
    CONTROL "All interfaces", IDC_OPT_NIC_ALL, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 140, 57, 150, 10
    LISTBOX IDC_OPT_NIC_LIST, 24, 74, 372, 88, LBS_MULTIPLESEL | WS_VSCROLL | WS_TABSTOP

    GROUPBOX "Advanced", IDC_OPT_GRP_ADVANCED, 16, 178, 388, 150
    LTEXT "TCP conn limit:", IDC_OPT_LBL_TCP_LIMIT, 24, 196, 70, 10
    EDITTEXT IDC_OPT_TCP_LIMIT, 110, 194, 60, 12, ES_NUMBER
    LTEXT "(0 = unlimited)", IDC_OPT_LBL_TCP_UNLIM, 180, 196, 60, 10

    LTEXT "UDP conn limit:", IDC_OPT_LBL_UDP_LIMIT, 24, 214, 70, 10
    EDITTEXT IDC_OPT_UDP_LIMIT, 110, 212, 60, 12, ES_NUMBER
    LTEXT "(0 = unlimited)", IDC_OPT_LBL_UDP_UNLIM, 180, 214, 60, 10

    LTEXT "Latency:", IDC_OPT_LBL_LATENCY, 24, 234, 70, 10
    EDITTEXT IDC_OPT_LATENCY, 110, 232, 60, 12, ES_NUMBER
    LTEXT "ms", IDC_OPT_LBL_MS2, 180, 234, 20, 10

    LTEXT "Packet loss:", IDC_OPT_LBL_PACKET_LOSS, 24, 254, 70, 10
    EDITTEXT IDC_OPT_PACKET_LOSS, 110, 252, 60, 12
    LTEXT "%", IDC_OPT_LBL_PERCENT, 180, 254, 20, 10

    LTEXT "Priority:", IDC_OPT_LBL_PRIORITY, 24, 274, 70, 10
    EDITTEXT IDC_OPT_PRIORITY, 110, 272, 60, 12

    // ============================ Tab 2: QoS ==================================
    CONTROL "Fair-share QoS", IDC_OPT_FAIR_SHARE, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 24, 48, 220, 12
    LTEXT "Fair-share QoS description", IDC_OPT_QOS_DESC, 24, 76, 372, 90

    // ============================ Tab 3: General ==============================
    GROUPBOX "Process Update Interval", IDC_OPT_GRP_UPDATE_INTERVAL, 16, 40, 388, 76
    LTEXT "Update every:", IDC_OPT_LBL_UPDATE_EVERY, 24, 58, 60, 10
    EDITTEXT IDC_OPT_UPDATE_INTERVAL, 90, 56, 60, 12, ES_NUMBER
    CONTROL "Packets", IDC_OPT_UPDATE_TYPE, "Button", BS_AUTORADIOBUTTON | WS_GROUP,
            160, 56, 70, 10
    CONTROL "Milliseconds", IDC_OPT_UPDATE_TYPE + 1, "Button", BS_AUTORADIOBUTTON,
            240, 56, 80, 10
    LTEXT "Cooldown:", IDC_OPT_LBL_COOLDOWN, 24, 78, 60, 10
    EDITTEXT IDC_OPT_UPDATE_COOLDOWN, 90, 76, 60, 12, ES_NUMBER
    LTEXT "ms", IDC_OPT_LBL_MS, 160, 78, 20, 10

    GROUPBOX "Language", IDC_OPT_GRP_LANGUAGE, 16, 124, 388, 40
    LTEXT "Language:", IDC_OPT_LBL_LANGUAGE, 24, 140, 60, 10
    COMBOBOX IDC_OPT_LANGUAGE, 90, 138, 140, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX "Behavior", IDC_OPT_GRP_BEHAVIOR, 16, 172, 388, 74
    CONTROL "Minimize to system tray", IDC_OPT_MINIMIZE_TRAY, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 24, 188, 240, 10
    CONTROL "Remember settings on exit", IDC_OPT_SAVE_SETTINGS, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 24, 204, 240, 10
    CONTROL "Remember sticky processes on exit", IDC_OPT_SAVE_STICKY_SETTINGS, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 24, 220, 260, 10
    CONTROL "Start shaping automatically", IDC_OPT_AUTO_START, "Button",
            BS_AUTOCHECKBOX | WS_TABSTOP, 24, 236, 260, 10

    GROUPBOX "File Paths", IDC_OPT_GRP_FILE_PATHS, 16, 254, 388, 84
    LTEXT "Config folder:", IDC_OPT_LBL_CONFIG_FOLDER, 24, 270, 70, 10
    EDITTEXT IDC_OPT_CONFIG_DIR, 100, 268, 262, 12, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_OPT_CONFIG_DIR_BROWSE, 368, 267, 28, 14
    LTEXT "(empty = same folder as the executable)", IDC_OPT_LBL_CONFIG_HINT, 100, 282, 220, 10

    LTEXT "Snapshots folder:", IDC_OPT_LBL_SNAPSHOT_FOLDER, 24, 300, 75, 10
    EDITTEXT IDC_OPT_SNAPSHOT_DIR, 100, 298, 262, 12, ES_AUTOHSCROLL
    PUSHBUTTON "...", IDC_OPT_SNAPSHOT_DIR_BROWSE, 368, 297, 28, 14
    LTEXT "(empty = same folder as the executable)", IDC_OPT_LBL_SNAPSHOT_HINT, 100, 312, 220, 10

    // Buttons
    DEFPUSHBUTTON "OK", IDOK, 270, 426, 60, 16
    PUSHBUTTON "Cancel", IDCANCEL, 340, 426, 60, 16
END

// --------------------------------------------------------------------
// Specify Process (lightweight name-entry dialog)
// --------------------------------------------------------------------
IDD_SPECIFY_PROC DIALOGEX 0, 0, 230, 64
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Specify Process"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Process name (without .exe):", IDC_SPECIFY_PROMPT, 8, 8, 160, 10
    EDITTEXT IDC_SPECIFY_NAME, 8, 22, 214, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON "Add",    IDOK,     112, 44, 50, 14
    PUSHBUTTON    "Cancel", IDCANCEL, 172, 44, 50, 14
END

// --------------------------------------------------------------------
// Statistics Window (not modal)
// --------------------------------------------------------------------
IDD_STATS_DIALOG DIALOGEX 0, 0, 500, 500
STYLE DS_SETFONT | WS_OVERLAPPEDWINDOW
CAPTION "Statistics - Windows QoS Trafficer"
FONT 9, "Segoe UI"
BEGIN
    // Download chart
    LTEXT "Download History", IDC_STATS_LBL_DL_HISTORY, 8, 8, 200, 10
    CONTROL "", IDC_STATS_DL_CHART, "STATIC", SS_BLACKRECT | WS_BORDER,
            8, 20, 480, 80

    // Upload chart
    LTEXT "Upload History", IDC_STATS_LBL_UL_HISTORY, 8, 108, 200, 10
    CONTROL "", IDC_STATS_UL_CHART, "STATIC", SS_BLACKRECT | WS_BORDER,
            8, 120, 480, 80

    // Per-process traffic list with label
    LTEXT "Per-Process Traffic", IDC_STATS_LBL_PROC_TRAFFIC, 8, 210, 200, 10
    CONTROL "", IDC_STATS_PROC_LIST, "SysListView32", 
            LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP,
            8, 222, 480, 150

    // Statistics text with label
    LTEXT "Statistics:", IDC_STATS_LBL_STATS, 8, 380, 80, 10
    EDITTEXT IDC_STATS_TEXT, 8, 395, 480, 70, ES_MULTILINE | ES_READONLY |
             WS_VSCROLL | ES_AUTOVSCROLL | NOT WS_TABSTOP

    // Buttons
    PUSHBUTTON "&Save Statistics", IDC_STATS_BTN_SAVE, 8, 470, 110, 23
    PUSHBUTTON "&Reset Statistics", IDC_STATS_BTN_RESET, 126, 470, 110, 23
    DEFPUSHBUTTON "&Close", IDCLOSE, 378, 470, 110, 23
END
